// Phosphor for VS Code
// In your settings.json, replace the whole "workbench.colorCustomizations" block
// and the two font lines with these.
  "workbench.colorCustomizations": {
    "editor.background": "#0d1117",
    "panel.background": "#0d1117",
    "terminal.background": "#0d1117",
    "sideBar.background": "#0a0e13",
    "activityBar.background": "#0a0e13",
    "titleBar.activeBackground": "#0a0e13",
    "statusBar.background": "#0a0e13",
    "editorGroupHeader.tabsBackground": "#0a0e13",
    "tab.inactiveBackground": "#0a0e13",
    "tab.activeBackground": "#0d1117",
    "tab.activeBorderTop": "#3fb950",
    "focusBorder": "#3fb950",
    "panel.border": "#21262d",
    "sideBar.border": "#21262d",
    "statusBar.foreground": "#7ee787",
    "activityBar.foreground": "#7ee787",
    "activityBarBadge.background": "#3fb950",
    "button.background": "#238636",
    "editorCursor.foreground": "#3fb950",
    "editor.selectionBackground": "#3fb95033",
    "editorLineNumber.foreground": "#484f58",
    "editorLineNumber.activeForeground": "#7ee787",
    "terminal.foreground": "#b5d8bc",
    "terminalCursor.foreground": "#3fb950",
    "terminal.ansiBlack": "#21262d",
    "terminal.ansiRed": "#f85149",
    "terminal.ansiGreen": "#3fb950",
    "terminal.ansiYellow": "#d29922",
    "terminal.ansiBlue": "#4ac1a8",
    "terminal.ansiMagenta": "#a8c97f",
    "terminal.ansiCyan": "#56d4dd",
    "terminal.ansiWhite": "#b5d8bc",
    "terminal.ansiBrightBlack": "#484f58",
    "terminal.ansiBrightRed": "#ff7b72",
    "terminal.ansiBrightGreen": "#7ee787",
    "terminal.ansiBrightYellow": "#e3b341",
    "terminal.ansiBrightBlue": "#6fdcc0",
    "terminal.ansiBrightMagenta": "#c3e88d",
    "terminal.ansiBrightCyan": "#87e1e8",
    "terminal.ansiBrightWhite": "#e6f4ea",
  },
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
